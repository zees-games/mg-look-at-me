# Godot 4
.godot/
/android/

# Every gs-* addon is a separate repository. For local development, symlink them.
# THIS LIST IS ALSO THE DEPENDENCY MANIFEST: gs-bootstrap derives what to link from it.
/addons/gs_core
/addons/gs_input
/addons/gs_profile
/addons/gs_profiler
/addons/gs_net
# gs-sim: optional native library (snapshot codec); without its built library the GDScript twins run.
# bootstrap fetches this release's library for the machine (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-sim v0.2.12
/addons/gs_sim
/addons/gs_player
/addons/gs_player_controller
/addons/gs_user_avatar
/addons/gs_achievements
/addons/gs_vote
/addons/gs_stats
/addons/gs_ui
/addons/gs_settings
/addons/gs_menu
/addons/gs_console
/addons/gs_platform
/addons/gs_user
/addons/gs_auth
/addons/gs_cloud
/addons/gs_moderation
/addons/gs_voice
/addons/gs_chat
/addons/gs_game
/addons/gs_workbench
/addons/gs_server
/addons/gs_audio
/addons/gs_fx

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/

# Editors
.vscode/
/addons/gs_player_char
/addons/gs_animation
/addons/gs_save
/addons/gs_camera
tools/__pycache__/
/addons/gs_map
/addons/gs_bot
/addons/gs_spawn
/addons/gs_team
/addons/gs_flashlight
/addons/gs_lighting

# The Look At Me maps are lam-maps, a repository and a pack of their own: one house each, linked into houses/.
# bootstrap-link: lam-maps/houses/lam_villa_night
/houses/lam_villa_night
# bootstrap-link: lam-maps/houses/lam_functionalist_night
/houses/lam_functionalist_night
# bootstrap-link: lam-maps/houses/lam_deco_mansion_night
/houses/lam_deco_mansion_night

# More gs-* addons linked locally (gs-bootstrap links them; each is its own repository).
/addons/gs_bot_record
/addons/gs_combat
/addons/gs_player_class
/addons/gs_server_query
/addons/gs_spectate
/addons/gs_sql
# godot-sqlite comes from gs-bot tools/fetch_sqlite.sh
/addons/godot-sqlite
/addons/gs_mobile
